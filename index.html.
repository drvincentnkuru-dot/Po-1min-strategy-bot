<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PO 1-Min Strategy Bot</title>
  <link rel="stylesheet" href="style.css">
</head>

<body>

<div class="container">

  <header>
    <h1>🤖 PO 1-MIN STRATEGY BOT</h1>
    <p>EMA 9/21 • Bollinger Bands • RSI 14 • S/R • Volatility</p>
    <div class="status">● OTC STRATEGY ENGINE</div>
  </header>

  <section class="controls">

    <label>MARKET</label>
    <select id="market">
      <option value="OTC">OTC MARKET</option>
    </select>

    <label>PAIR</label>
    <select id="pair"></select>

    <label>EXPIRATION</label>

    <div class="expiry-buttons">
      <button class="expiry active" data-expiry="1">1 MIN</button>
      <button class="expiry" data-expiry="2">2 MIN</button>
      <button class="expiry" data-expiry="3">3 MIN</button>
    </div>

    <button id="analyzeBtn" class="analyze-btn">
      ANALYZE MARKET
    </button>

  </section>

  <section class="signal-card">

    <h2>AI SIGNAL</h2>

    <div id="signalDisplay" class="signal-display no-trade">
      <span id="signalText">NO TRADE</span>
    </div>

    <div class="confidence">
      Confidence:
      <strong id="confidence">0%</strong>
    </div>

    <div class="time-info">

      <div>
        <span>Entry</span>
        <strong id="entry">--:--:--</strong>
      </div>

      <div>
        <span>Expiry</span>
        <strong id="expiryTime">--:--:--</strong>
      </div>

    </div>

    <div class="analysis-grid">

      <div class="analysis-item">
        <span>EMA 9 / 21</span>
        <strong id="emaStatus">WAITING</strong>
      </div>

      <div class="analysis-item">
        <span>Bollinger Bands</span>
        <strong id="bbStatus">WAITING</strong>
      </div>

      <div class="analysis-item">
        <span>RSI 14</span>
        <strong id="rsiStatus">WAITING</strong>
      </div>

      <div class="analysis-item">
        <span>Support</span>
        <strong id="supportStatus">WAITING</strong>
      </div>

      <div class="analysis-item">
        <span>Resistance</span>
        <strong id="resistanceStatus">WAITING</strong>
      </div>

      <div class="analysis-item">
        <span>Volatility</span>
        <strong id="volatilityStatus">WAITING</strong>
      </div>

      <div class="analysis-item">
        <span>Market Condition</span>
        <strong id="marketStatus">WAITING</strong>
      </div>

    </div>

  </section>

  <section class="all-signals">

    <h2>ALL TIMEFRAMES</h2>

    <div class="signal-row">
      <span>1 MIN</span>
      <strong id="signal1">NO TRADE</strong>
      <span id="confidence1">0%</span>
    </div>

    <div class="signal-row">
      <span>2 MIN</span>
      <strong id="signal2">NO TRADE</strong>
      <span id="confidence2">0%</span>
    </div>

    <div class="signal-row">
      <span>3 MIN</span>
      <strong id="signal3">NO TRADE</strong>
      <span id="confidence3">0%</span>
    </div>

  </section>

  <section class="risk-card">

    <h2>💰 MONEY MANAGEMENT</h2>

    <div class="risk-grid">

      <div>
        <span>Risk</span>
        <strong>1–2%</strong>
      </div>

      <div>
        <span>Max Trades</span>
        <strong>2</strong>
      </div>

      <div>
        <span>Loss Stop</span>
        <strong>3 Losses</strong>
      </div>

      <div>
        <span>Recovery</span>
        <strong>2.3–2.5x</strong>
      </div>

    </div>

    <p class="warning">
      Demo / analysis only. No automatic real-money trading.
    </p>

  </section>

  <section class="history">

    <h2>SIGNAL HISTORY</h2>

    <div id="historyList">
      <p class="empty">No signals analyzed yet.</p>
    </div>

  </section>

  <footer>
    <p>PO 1-Min Strategy Bot V1</p>
    <small>Demo Strategy Engine</small>
  </footer>

</div>

<script src="script.js"></script>

</body>
</html>
